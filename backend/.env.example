# ── Required ────────────────────────────────────────────────────────────────
# Get your key at: https://build.nvidia.com
NVIDIA_API_KEY=""

# ── Auth (NEW) ──────────────────────────────────────────────────────────────
# Set a strong random string — all API calls must include X-API-Key: <value>
# Leave empty to disable auth (development only)
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
AXIO_API_KEY=

# ── Redis sessions (NEW) ────────────────────────────────────────────────────
# Strongly recommended for production — prevents session loss on restart/crash
# Format: redis://[:password@]host[:port][/db]
# Leave empty to use in-memory fallback (sessions lost on restart)
REDIS_URL=redis://localhost:6379/0

# ── Optional overrides ──────────────────────────────────────────────────────
NVIDIA_NIM_MODEL=nvidia/nemotron-3-super-120b-a12b

# Comma-separated allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,https://yourdomain.com

# production | development  (hides /docs in production)
ENV=production

# Max CSV/Excel upload size in MB
MAX_UPLOAD_MB=50

# Session auto-cleanup after N hours
SESSION_TTL_HOURS=24

# Gunicorn parallel training workers
TRAIN_WORKERS=4
